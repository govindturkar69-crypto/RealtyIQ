# Server
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# MongoDB Atlas (or local: mongodb://127.0.0.1:27017/realtyiq)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/realtyiq

# Auth
# Production: unique random values, at least 32 characters each.
JWT_ACCESS_SECRET=replace_with_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ML inference service (FastAPI from Phase 1)
ML_SERVICE_URL=http://localhost:8001
# Required for protected ML calls and must match the ML service value.
ML_SERVICE_TOKEN=replace_with_long_random_service_token_at_least_32_chars

# Required only when running the controlled admin bootstrap/seed command.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_chars
# Required target safety markers; only local/allowlisted disposable MongoDB targets pass.
REALTYIQ_DISPOSABLE_DB=false
REALTYIQ_DISPOSABLE_DB_CONFIRM=
# Optional disposable demo account for npm run seed (never a published default).
# SEED_DEMO_EMAIL=demo@example.com
# SEED_DEMO_PASSWORD=replace_with_a_unique_password_at_least_16_chars

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5
SAVED_SEARCH_MAX=20
FAVORITES_MAX=100
SHARE_TOKEN_TTL_MS=604800000
LEGACY_SHARE_GRACE_DAYS=30
PREDICTION_RETENTION_DAYS=365
SECURITY_EVENT_RETENTION_DAYS=365
